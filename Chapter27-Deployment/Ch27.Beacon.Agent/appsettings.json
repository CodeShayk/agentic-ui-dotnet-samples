{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.AI": "Information"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 25,
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Beacon": {
    "Hosting": {
      "RunBudgetSeconds": 210,
      "DrainSeconds": 20
    },
    "Conversations": {
      "Directory": "App_Data/conversations",
      "RetentionDays": 90,
      "EventLogRetentionDays": 30
    },
    "Limits": {
      "MaxRequestBodyBytes": 262144,
      "MaxNewMessages": 50,
      "MaxUserMessageChars": 4000,
      "MaxToolResultChars": 4000
    },
    "Security": {
      "RunsPerMinute": 30
    },
    "Approvals": {
      "TimeToLive": "00:10:00",
      "MaxReasonLength": 500
    },
    "Streaming": {
      "HeartbeatInterval": "00:00:15",
      "EnableProtobuf": true,
      "MaxConcurrentRuns": 500,
      "RunIdRetention": "00:10:00"
    },
    "Telemetry": {
      "EnableSensitiveData": false
    },
    "Pricing": {
      "Models": [
        {
          "Model": "beacon-scripted",
          "InputPerMillionTokens": 0.40,
          "CachedInputPerMillionTokens": 0.10,
          "OutputPerMillionTokens": 1.60
        }
      ]
    }
  }
}
