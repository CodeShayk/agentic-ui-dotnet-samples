<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Chapter 27: Beacon Desk, deployed. Every page needs a signed-in user: Microsoft Entra ID through
    Microsoft.Identity.Web when deployed, a development sign-in on a laptop. The chat runs with Interactive
    Server rendering, so the Desk's server calls the agent (a backend for frontend) with the signed-in user's
    token and finds it through service discovery. Build an image without a Dockerfile:
      dotnet publish -c Release -t:PublishContainer
  -->
  <PropertyGroup>
    <RootNamespace>Ch27.Beacon.Desk</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ContainerRepository>contoso/beacon-desk</ContainerRepository>
    <ContainerFamily>resolute-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ch27.ServiceDefaults\Ch27.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.Desk.Ui\Beacon.Desk.Ui.csproj" />
  </ItemGroup>

</Project>
