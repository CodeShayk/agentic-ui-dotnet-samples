@*
    The activity line for one assistant message's tool calls: a status mark and a sentence per call.
    The mark is decorative; the sentence carries the status for screen readers.
*@
<ul class="ch14-tools" aria-label="Tool activity">
    @foreach (var call in Calls)
    {
        <li class="ch14-tools__call ch14-tools__call--@call.Status.ToString().ToLowerInvariant()">
            <span class="ch14-tools__mark" aria-hidden="true"></span>
            <span>@ToolLine.Describe(call)</span>
            <code class="ch14-tools__name">@call.Name</code>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ToolCallView> Calls { get; set; } = [];
}
