<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Chapter 21: Beacon's agent with two protocols behind it. Equipment manuals come from an MCP
    server (ModelContextProtocol, McpClientTool as AIFunction, behind an allow-list); part availability
    comes from Northwind Supply's agent over A2A (A2A 1.0.0-preview2, a preview), exposed to the model
    as a tool and attributed on the AG-UI stream as a subagent. Everything external is labeled,
    filtered and size-limited before the model sees it.
    Keep AI:ApiKey in User Secrets: dotnet user-secrets set "AI:ApiKey" "<key>"
  -->
  <PropertyGroup>
    <RootNamespace>Ch21.Beacon.Agent</RootNamespace>
    <UserSecretsId>beacon-ch21-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.AI\Beacon.AI.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.AGUI.Hosting\Beacon.AGUI.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="A2A" />
  </ItemGroup>

</Project>
