@* Adapted from Chapter 7: the same chat, with this chapter's suggestions and no reconciliation badge. *@
@*
    Beacon Desk's chat, driven by the conversation's view state. Everything it shows is projected
    from one immutable ConversationView, read once per render.
*@
@{
    var view = Conversation.View;
    var transcript = Project(view);
}
<ChatPanel @ref="_panel"
           Messages="transcript.Messages"
           Streaming="transcript.Streaming"
           Status="StatusOf(view)"
           ThreadId="@view.ThreadId"
           RunId="@view.CurrentRun?.RunId"
           Error="@ErrorOf(view)"
           Disabled="!RendererInfo.IsInteractive"
           OnSend="SendAsync"
           OnStop="Conversation.Stop"
           OnNewChat="NewChat">
    <EmptyContent>
        <p>Open a work order on the sheet, then work on it together. For example:</p>
        <ul class="bd-suggestions">
            @foreach (var prompt in Suggestions)
            {
                <li>
                    <button type="button"
                            class="bd-button bd-suggestion"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="() => SendAsync(prompt)">@prompt</button>
                </li>
            }
        </ul>
    </EmptyContent>
    <AfterMessages>
        @if (view.OpenInterrupts.FirstOrDefault() is { } waiting)
        {
            <p class="ch12-waiting" role="status">
                Beacon is waiting for a decision this Desk can't make yet: @waiting.Message
                Start a new chat to carry on.
            </p>
        }
    </AfterMessages>
    <MessageTemplate Context="message">
        @if (message.Id.StartsWith(DeskTranscript.ToolLinePrefix, StringComparison.Ordinal)
             && view.FindMessage(message.Id[DeskTranscript.ToolLinePrefix.Length..]) is AssistantMessageView caller)
        {
            <ToolActivityLine Calls="[.. view.ToolCallsOf(caller)]" />
        }
        else if (message.Author == ChatAuthor.Assistant)
        {
            <MarkdownView Markdown="@message.Text" />
        }
        else
        {
            <p class="bd-message__text">@message.Text</p>
        }
    </MessageTemplate>
</ChatPanel>

@code {
    private static readonly string[] Suggestions =
    [
        "Open WO-1001",
        "Priya measured the run capacitor on WO-1001: it reads 38 µF against its 45 µF rating, 15.6% low.",
        "Add a return visit on the day selected on my board.",
    ];
}
