{
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 40
  },
  "Beacon": {
    "Conversations": {
      "Directory": "App_Data/conversations",
      "RetentionDays": 90,
      "EventLogRetentionDays": 30
    },
    "Compaction": {
      "MaxContextTokens": 1500,
      "KeepRecentTurns": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
