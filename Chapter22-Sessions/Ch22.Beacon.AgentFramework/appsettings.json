{
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 40
  },
  "Beacon": {
    "Sessions": {
      "Directory": "App_Data/sessions"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
