<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The part of Beacon Desk that can run in the browser. Components here render with Interactive
    Server or Interactive WebAssembly, whichever the page asks for; DeskChat is the same code in both.
  -->
  <PropertyGroup>
    <RootNamespace>Ch06.Beacon.Desk.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.Desk.Ui\Beacon.Desk.Ui.csproj" />
  </ItemGroup>

</Project>
