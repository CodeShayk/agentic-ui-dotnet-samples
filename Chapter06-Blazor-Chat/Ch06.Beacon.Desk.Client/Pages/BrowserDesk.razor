@page "/browser"

<PageTitle>Beacon Desk (browser)</PageTitle>

<DeskHome ChatRenderMode="InteractiveWebAssembly">
    <About>
        <p>
            This page runs the chat with <strong>Interactive WebAssembly</strong>: the conversation lives in your
            browser, which calls Beacon's agent directly. The agent allows this origin through CORS.
        </p>
    </About>
</DeskHome>
