{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 25,
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2"
  },
  "Beacon": {
    "Streaming": {
      "HeartbeatInterval": "00:00:15",
      "StripRawEvent": true,
      "EnableProtobuf": true,
      "MaxConcurrentRuns": 500,
      "RunTimeout": "00:02:00",
      "RunIdRetention": "00:10:00"
    },
    "Simulation": {
      "FirstChunkDelay": "00:00:00"
    }
  }
}
