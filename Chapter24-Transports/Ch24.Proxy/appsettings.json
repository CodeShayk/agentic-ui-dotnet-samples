{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "direct": {
        "ClusterId": "agent",
        "Match": { "Path": "/direct/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/direct" } ]
      },
      "inspected": {
        "ClusterId": "agent",
        "Match": { "Path": "/inspected/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/inspected" } ],
        "Metadata": { "InspectResponseBody": "true" }
      }
    },
    "Clusters": {
      "agent": {
        "Destinations": {
          "beacon": { "Address": "http://localhost:5240/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        }
      }
    }
  }
}
