  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ch24.Beacon.Agent\Ch24.Beacon.Agent.csproj" />
    <ProjectReference Include="..\Ch24.Beacon.Console\Ch24.Beacon.Console.csproj" />
    <ProjectReference Include="..\Ch24.Proxy\Ch24.Proxy.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.Testing\Beacon.Testing.csproj" />
  </ItemGroup>

