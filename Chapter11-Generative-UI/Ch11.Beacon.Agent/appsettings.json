{
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 40
  },
  "Beacon": {
    "StreamToolArguments": true,
    "ArgumentFragmentDelayMilliseconds": 60,
    "ArgumentFragmentLength": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
