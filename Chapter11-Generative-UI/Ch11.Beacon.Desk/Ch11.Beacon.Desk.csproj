    registry maps component names to Blazor components, DynamicComponent renders them from the
    conversation's tool calls as their props stream, and a fallback covers what can't be shown.
    Interactive Server.
  -->
  <PropertyGroup>
    <RootNamespace>Ch11.Beacon.Desk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ch11.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.Desk.Ui\Beacon.Desk.Ui.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.Client.Core\Beacon.Client.Core.csproj" />
    <ProjectReference Include="..\Ch11.Beacon.Components\Ch11.Beacon.Components.csproj" />
    <ProjectReference Include="..\Ch11.Beacon.ComponentViews\Ch11.Beacon.ComponentViews.csproj" />
  </ItemGroup>

</Project>
