@*
    Beacon Desk's workspace: the dispatch board in the work area and the chat beside it. Both read the
    circuit's DeskScreen; Beacon changes the board only through the Desk's frontend tools.
*@
<DeskShell WorkAreaLabel="Dispatch board">
    <WorkArea>
        <DispatchBoard />
    </WorkArea>
    <Chat>
        <DeskChat />
    </Chat>
</DeskShell>
