@*
    Beacon Desk's workspace: the surface inspector in the work area and the chat beside it. The chat draws
    the agent's forms where they arrived; the inspector shows what the Desk's validator decided about each.
*@
<DeskShell>
    <WorkArea>
        <SurfaceInspector />
    </WorkArea>
    <Chat>
        <DeskChat />
    </Chat>
</DeskShell>
