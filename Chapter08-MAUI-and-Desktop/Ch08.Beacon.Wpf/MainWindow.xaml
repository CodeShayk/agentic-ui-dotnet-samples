<Window x:Class="Ch08.Beacon.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch08.Beacon.Wpf"
        xmlns:core="clr-namespace:Ch08.Field.Core.Presentation;assembly=Ch08.Field.Core"
        Width="760" Height="640" MinWidth="480" MinHeight="400"
        FontFamily="Segoe UI" FontSize="14" Background="White">

    <DockPanel Margin="16">
        <!-- Header, status and the live region for announcements. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Beacon" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="Status" Text="{Binding StatusText}" Foreground="{StaticResource Muted}"
                           AutomationProperties.AutomationId="Status" />
                <!-- A polite live region, invisible but in the accessibility tree: what Narrator reads aloud. -->
                <TextBlock x:Name="Announcer" Height="1" Opacity="0" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="Announcer" />
            </StackPanel>
            <Button Grid.Column="1" Content="New chat" Command="{Binding NewChatCommand}" Padding="14,6"
                    VerticalAlignment="Center" AutomationProperties.AutomationId="NewChat" />
        </Grid>

        <!-- Recovery advice after a turn that didn't finish. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12" CornerRadius="6"
                Background="{StaticResource AmberSurface}" BorderBrush="{StaticResource Amber}" BorderThickness="2"
                Visibility="{Binding HasRecovery, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="{Binding Recovery.Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryMessage" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{Binding Recovery.ActionLabel}" Command="{Binding RecoveryCommand}" Padding="12,4" Margin="0,0,8,0"
                            Visibility="{Binding HasRecoveryAction, Converter={StaticResource Visible}}"
                            AutomationProperties.AutomationId="RecoveryAction" />
                    <Button Content="Dismiss" Command="{Binding DismissRecoveryCommand}" Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Composer. Enter sends; Escape stops. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Composer" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                     AutomationProperties.Name="Message to Beacon" AutomationProperties.AutomationId="Composer">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" MinWidth="88" Margin="8,0,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource Collapsed}}"
                    x:Name="SendButton" AutomationProperties.AutomationId="Send" />
            <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" MinWidth="88" Margin="8,0,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                    Background="#D13438" Foreground="White" AutomationProperties.AutomationId="Stop" />
        </Grid>

        <!-- Transcript. -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Transcript">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:MessageItem}">
                        <StackPanel Margin="0,4">
                            <Border x:Name="Bubble" Padding="12,8" CornerRadius="10" Background="#F5F5F5"
                                    Visibility="{Binding HasText, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,2,80,0">
                                <StackPanel>
                                    <TextBlock x:Name="Body" TextWrapping="Wrap" local:InlineText.Runs="{Binding Runs}"
                                               AutomationProperties.Name="{Binding AccessibleText}" />
                                    <TextBlock Text="Cut off before Beacon finished." FontStyle="Italic" FontSize="12"
                                               Foreground="{StaticResource Muted}"
                                               Visibility="{Binding IsPartial, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Activity}" FontStyle="Italic" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding HasActivity, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Primary}" />
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Margin" Value="80,2,0,0" />
                                <Setter TargetName="Body" Property="Foreground" Value="White" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
