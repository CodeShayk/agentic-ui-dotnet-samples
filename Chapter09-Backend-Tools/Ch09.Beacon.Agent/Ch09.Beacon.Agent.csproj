<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Beacon's agent for Chapter 9: Chapter 5's pipeline with backend tools worth watching. A simulated
    back office makes the tools slow (and the warranty service fail for one unit), the tools run
    concurrently when the model asks for several at once, failures reach the model and the Desk as a
    sanitized error, and tool-call arguments stream as fragments (MapStreamingToolCallArguments).
  -->
  <PropertyGroup>
    <RootNamespace>Ch09.Beacon.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.Domain\Beacon.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.AI\Beacon.AI.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.AGUI.Hosting\Beacon.AGUI.Hosting.csproj" />
  </ItemGroup>

</Project>
