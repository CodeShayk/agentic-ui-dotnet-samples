<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Chapter 5, optional path: the same model and middleware as Ch05.Beacon.Agent, turned into a
    Microsoft Agent Framework agent and hosted with MapAGUIServer.
    Microsoft.Agents.AI.Hosting.AGUI.AspNetCore is a PREVIEW package (1.23.0-preview.260928.1);
    Microsoft.Agents.AI itself is stable. AgentSessionStore and InMemoryAgentSessionStore are
    experimental (MAAI001, suppressed in Directory.Build.props).
  -->
  <PropertyGroup>
    <RootNamespace>Ch05.Beacon.AgentFramework</RootNamespace>
    <UserSecretsId>beacon-ch05-agentframework</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Abstractions" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.AI\Beacon.AI.csproj" />
    <ProjectReference Include="..\Ch05.Beacon.Pipeline\Ch05.Beacon.Pipeline.csproj" />
  </ItemGroup>

</Project>
