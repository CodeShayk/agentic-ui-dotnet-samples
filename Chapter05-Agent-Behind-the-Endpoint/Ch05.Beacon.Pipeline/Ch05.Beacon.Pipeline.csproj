<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 5: the pieces of Beacon's chat client pipeline that both hosts share. Ch05.Beacon.Agent
    hosts the pipeline with the book's endpoint glue; Ch05.Beacon.AgentFramework hosts it behind
    Microsoft Agent Framework. Keeping the policy here means the two hosts can't drift apart.
  -->
  <PropertyGroup>
    <RootNamespace>Ch05.Beacon.Pipeline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

</Project>
