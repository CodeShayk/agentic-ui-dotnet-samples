<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Beacon's agent for Chapter 18: a coordinator that plans, delegates to parts, scheduling and warranty
    specialists running in parallel, and answers from their reports. Each specialist is its own
    IChatClient pipeline with its own instructions and tools. The coordinator reports every invocation
    with SUBAGENT_* events and attributes the specialists' messages and tool calls with subagentRunId;
    its own phases are STEP_* events. The parts specialist can suspend on Chapter 14's spending
    approval, and the dispatcher's answer resumes it through the coordinator.
  -->
  <PropertyGroup>
    <RootNamespace>Ch18.Beacon.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.Domain\Beacon.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.AI\Beacon.AI.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.AGUI.Hosting\Beacon.AGUI.Hosting.csproj" />
  </ItemGroup>

</Project>
