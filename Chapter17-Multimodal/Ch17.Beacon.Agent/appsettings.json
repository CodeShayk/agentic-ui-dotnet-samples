{
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 40
  },
  "Beacon": {
    "Media": {
      "AllowedUrlHosts": [ "media.contoso-climate.example" ],
      "FetchTimeoutSeconds": 10,
      "MaxRedirects": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
