<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 13's proof: a run captured from Ch13.Beacon.Agent replays through the real client stack into
    the same sequence of visible states every time; the agent's predicted state, activity and steps are
    checked on the wire (in-process, no delays); and the pieces behind them (the partial-JSON reader,
    the state writer's dedup, the render gate) are tested on their own. No model, no browser, no network.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch13.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="AGUI.Formatting" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Beacon.Client.Core\Beacon.Client.Core.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.Desk.Ui\Beacon.Desk.Ui.csproj" />
    <ProjectReference Include="..\..\Shared\Beacon.Testing\Beacon.Testing.csproj" />
    <ProjectReference Include="..\Ch13.Beacon.Agent\Ch13.Beacon.Agent.csproj" />
    <ProjectReference Include="..\Ch13.Beacon.Desk\Ch13.Beacon.Desk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Recordings\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
