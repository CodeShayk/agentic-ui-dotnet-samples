@*
    Copied from Chapter 10 (Ch10.Beacon.Desk). The activity line for one assistant message's tool calls: a status mark, a sentence and who ran it.
    The mark is decorative; the sentence carries the status for screen readers.
*@
<ul class="ch15-tools" aria-label="Tool activity">
    @foreach (var call in Calls)
    {
        <li class="ch15-tools__call ch15-tools__call--@call.Status.ToString().ToLowerInvariant()">
            <span class="ch15-tools__mark" aria-hidden="true"></span>
            <span>@ToolLine.Describe(call)</span>
            <code class="ch15-tools__name">@call.Name</code>
            @if (ToolLine.Where(call) is { Length: > 0 } where)
            {
                <span class="ch15-tools__where">@where</span>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ToolCallView> Calls { get; set; } = [];
}
