{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 25,
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5231" ]
  },
  "Beacon": {
    "Limits": {
      "MaxRequestBodyBytes": 262144,
      "MaxNewMessages": 50,
      "MaxUserMessageChars": 4000,
      "MaxToolResultChars": 4000
    },
    "Security": {
      "RunTimeoutSeconds": 120,
      "RunsPerMinute": 30
    }
  }
}
