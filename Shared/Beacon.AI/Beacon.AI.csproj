<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Model access for Beacon's agent: provider selection from configuration, Beacon's tools,
    the system instructions and a deterministic scripted model for running without keys.
    Server-side only.
  -->
  <PropertyGroup>
    <RootNamespace>Beacon.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beacon.Domain\Beacon.Domain.csproj" />
  </ItemGroup>

</Project>
