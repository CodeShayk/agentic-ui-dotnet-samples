@namespace Beacon.Desk.Ui
@*
    The two-pane Desk: the work area on the left, the chat panel on the right. Below about 960 pixels
    the panes stack, chat last, in source order (which is also reading and tab order).
*@
<div class="bd-shell">
    <section class="bd-shell__work" aria-label="@WorkAreaLabel">
        @WorkArea
    </section>
    <div class="bd-shell__chat" id="@ChatId">
        @Chat
    </div>
</div>

@code {
    [Parameter] public RenderFragment? WorkArea { get; set; }

    [Parameter] public RenderFragment? Chat { get; set; }

    [Parameter] public string WorkAreaLabel { get; set; } = "Work area";

    /// <summary>The element ID of the chat pane, for skip links.</summary>
    [Parameter] public string ChatId { get; set; } = "beacon-chat";
}
