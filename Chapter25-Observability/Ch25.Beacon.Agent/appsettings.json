{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Scripted",
    "ScriptedChunkDelayMilliseconds": 25,
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2"
  },
  "Beacon": {
    "Telemetry": {
      "ServiceName": "beacon-agent",
      "ConsoleExporter": true,
      "EnableSensitiveData": false
    },
    "FaultArchive": {
      "BaseAddress": "",
      "DelayMilliseconds": 0
    },
    "Pricing": {
      "Models": [
        {
          "Model": "beacon-scripted",
          "InputPerMillionTokens": 0.40,
          "CachedInputPerMillionTokens": 0.10,
          "OutputPerMillionTokens": 1.60
        },
        {
          "Model": "llama3.2",
          "InputPerMillionTokens": 0,
          "OutputPerMillionTokens": 0
        }
      ]
    }
  }
}
