<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 25: a traced console client for Beacon. It enables the AG-UI client instrumentation
    (Experimental.AGUI.Client), a client-side chat span and HttpClient instrumentation, so one trace
    runs from the client through the agent. It can also capture each run's wire traffic to disk and
    replay a capture through AGUIChatClient without a server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch25.Beacon.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="AGUI.Formatting" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
  </ItemGroup>

</Project>
